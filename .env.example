# Copy this file to .env.local for local provider work. Never commit real values.
PORT=4317
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
FAL_KEY=
NEBIUS_API_KEY=
SLNG_API_KEY=
NEBIUS_MODEL=
SLNG_STT_MODEL=
# Region hosting the speech model: us-east (default) or us-west.
SLNG_REGION=
# Live media. The current Vonage Video API authenticates with a video-capable application:
# set VONAGE_APPLICATION_ID and VONAGE_PRIVATE_KEY (PEM, \n escapes accepted). A legacy
# OpenTok project uses a numeric VONAGE_API_KEY with VONAGE_API_SECRET instead. An
# account-level API key is not a video credential and is refused. Server-only, all of them.
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_APPLICATION_ID=
VONAGE_PRIVATE_KEY=
# Total USD this server may commit to paid generation. The live director
# reserves against it per session, so an empty value means no director session
# can be opened at all.
FAL_ASSET_BUDGET_USD=
# The live director (minimax/h3-max/director) is the only video path. It is
# gated separately from script generation because it bills per second of
# session runtime with a 60-second minimum, so REVERIE_LIVE_ENABLED alone must
# not buy it.
REVERIE_DIRECTOR_ENABLED=false
REVERIE_DIRECTOR_RESOLUTION=768p
# The WebM recorder muxes the incoming track ON the Node thread, which pins a
# core and blocks the event loop — the server stops answering at all, including
# the route that ends the paid session. Leave it off. Durable capture is the
# segmenter's job (below), which runs in a worker thread.
REVERIE_DIRECTOR_RECORD=false
# Live HLS delivery of the stream: fMP4 segments muxed in a worker thread and
# served over plain HTTP, so every viewer on a configuration reads the same
# files. Off until a real session has shown /end answering while the worker is
# mid-segment; nothing on this path has been run against the provider. The
# segmenter itself runs whenever any sink wants segments — a durable archive
# keeps receiving them with this off.
REVERIE_DIRECTOR_HLS=false
REVERIE_DIRECTOR_ASPECT_RATIO=16:9
# Spend guards. The default rate is fal's list price, which never understates
# the bill; the promotional rate is lower.
REVERIE_DIRECTOR_USD_PER_SECOND=0.08
REVERIE_DIRECTOR_MAX_SESSIONS=1
REVERIE_DIRECTOR_MAX_SESSION_SECONDS=120
# Director recordings live in REVERIE_PORTION_BUCKET under a director/ prefix
# and need SUPABASE_SERVICE_ROLE_KEY. Without it a recording is held in memory
# and lost on restart, and the API reports that honestly.
# Discover reads public.catalogue_titles (a curated TMDB snapshot) from the same Supabase
# project, as the viewer's own session. The server uses SUPABASE_URL/SUPABASE_ANON_KEY,
# falling back to the VITE_ values above. There is no Titan API and no TITAN_* variable.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Director recordings are stored in a private Supabase Storage bucket when the server
# holds a service-role key. Server-only: it bypasses RLS, so it must never be a VITE_ value
# and never reaches the browser. Without it, recordings stay in memory and are lost on restart.
SUPABASE_SERVICE_ROLE_KEY=
REVERIE_PORTION_BUCKET=jam-portions
# Live media and paid generation stay off until this is exactly "true".
REVERIE_LIVE_ENABLED=false
# Offline accessibility backfill only (pnpm backfill:accessibility subtitles). An API consumer
# key from https://www.opensubtitles.com/en/consumers. Never used by the app or any request.
OPENSUBTITLES_API_KEY=
