# Copy this file to .env.local for local provider work. Never commit real values.
PORT=4317
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
FAL_KEY=
NEBIUS_API_KEY=
SLNG_API_KEY=
NEBIUS_MODEL=
SLNG_STT_MODEL=
# Region hosting the speech model: us-east (default) or us-west.
SLNG_REGION=
# Live media. The current Vonage Video API authenticates with a video-capable application:
# set VONAGE_APPLICATION_ID and VONAGE_PRIVATE_KEY (PEM, \n escapes accepted). A legacy
# OpenTok project uses a numeric VONAGE_API_KEY with VONAGE_API_SECRET instead. An
# account-level API key is not a video credential and is refused. Server-only, all of them.
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_APPLICATION_ID=
VONAGE_PRIVATE_KEY=
# This build does not track what generation costs: there is no budget, no
# ledger and no spend variable. Generation is gated by the live flags and the
# provider keys below, and bounded by session duration and concurrency.
# See docs/DECISIONS.md.
# The live director (minimax/h3-max/director) is the only video path. It is
# gated separately from script generation because it holds a live provider
# session, so REVERIE_LIVE_ENABLED alone must not open one.
REVERIE_DIRECTOR_ENABLED=false
REVERIE_DIRECTOR_RESOLUTION=768p
# The WebM recorder muxes the incoming track ON the Node thread, which pins a
# core and blocks the event loop — the server stops answering at all, including
# the route that ends the provider session. Leave it off. Durable capture is the
# segmenter's job (below), which runs in a worker thread.
REVERIE_DIRECTOR_RECORD=false
# Live HLS delivery of the stream: fMP4 segments muxed in a worker thread and
# served over plain HTTP, so every viewer on a configuration reads the same
# files. Off until a real session has shown /end answering while the worker is
# mid-segment; nothing on this path has been run against the provider. The
# segmenter itself runs whenever any sink wants segments — a durable archive
# keeps receiving them with this off.
REVERIE_DIRECTOR_HLS=false
REVERIE_DIRECTOR_ASPECT_RATIO=16:9
# How many director sessions may run at once, and how long one may live. A
# session stops itself at the ceiling whether or not the room is done with it,
# so an abandoned tab cannot hold a provider stream open indefinitely.
REVERIE_DIRECTOR_MAX_SESSIONS=1
REVERIE_DIRECTOR_MAX_SESSION_SECONDS=120
# Director recordings live in REVERIE_PORTION_BUCKET under a director/ prefix
# and need SUPABASE_SERVICE_ROLE_KEY. Without it a recording is held in memory
# and lost on restart, and the API reports that honestly.
# Beat generation (minimax/h3-max/text-to-video, and
# minimax/h3-max/reference-to-video when someone in the room has agreed to
# appear in the film). Gated on REVERIE_LIVE_ENABLED and FAL_KEY; it is NOT
# gated behind the director's flag, because the two are different products.
# See docs/specs/appearing-in-the-film.md.
REVERIE_BEAT_RESOLUTION=768P
REVERIE_BEAT_ASPECT_RATIO=16:9
# How many beats may be generating at once. A concurrency guard, for the
# provider's rate limits and this server's memory.
REVERIE_BEAT_MAX_CONCURRENT=2
# Approved likeness frames and generated beat clips live in
# REVERIE_PORTION_BUCKET under likeness/ and beats/ prefixes and need
# SUPABASE_SERVICE_ROLE_KEY. Without it both are held in memory, lost on
# restart, and the routes report durable: false rather than implying an archive.
# Discover reads public.catalogue_titles (a curated TMDB snapshot) from the same Supabase
# project, as the viewer's own session. The server uses SUPABASE_URL/SUPABASE_ANON_KEY,
# falling back to the VITE_ values above. There is no Titan API and no TITAN_* variable.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Director recordings are stored in a private Supabase Storage bucket when the server
# holds a service-role key. Server-only: it bypasses RLS, so it must never be a VITE_ value
# and never reaches the browser. Without it, recordings stay in memory and are lost on restart.
SUPABASE_SERVICE_ROLE_KEY=
REVERIE_PORTION_BUCKET=jam-portions
# Live media and paid generation stay off until this is exactly "true".
REVERIE_LIVE_ENABLED=false
# The escape room generates its segments through the fal adapter's queue half.
# FAL_MODEL selects one entry of the server-owned allowlist
# (minimax/h3-max/text-to-video, minimax/h3-max-turbo/text-to-video); an
# unknown value is refused rather than quietly replaced. Empty means entry [0].
FAL_MODEL=
# Escape-room generation. Measured against the provider: a 15s beat takes
# about 25s to become playable, a 5s location loop about 9s.
REVERIE_ESCAPE_LOOP_SECONDS=5
REVERIE_ESCAPE_MAX_GENERATIONS=2
# Offline accessibility backfill only (pnpm backfill:accessibility subtitles). An API consumer
# key from https://www.opensubtitles.com/en/consumers. Never used by the app or any request.
OPENSUBTITLES_API_KEY=
# The bearer token an external evaluation harness presents to /api/evaluate.
# One shared secret, compared in full, and the only credential that endpoint
# accepts: it never takes a viewer's Supabase session, because there is no
# viewer behind it. Empty means the endpoint is off and answers 401 to
# everything. Generate one with `openssl rand -hex 32` and keep it in
# .env.local and in the deployment's own environment, never here.
GALTEA_EVAL_TOKEN=
